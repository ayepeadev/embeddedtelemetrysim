{
    "name": "Embedded Telemetry Sim",

    "image": "mcr.microsoft.com/devcontainers/cpp:1-bullseye",

    "postCreateCommand": "sudo apt update && sudo apt install -y cmake gdb",

    "customizations": {
        "vscode": {
            "settings": {
                "C_Cpp.default.cppStandard": "c++17",
                "editor.formatOnSave": true
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools-extension-pack",
                "xaver.clang-format"
            ]
        }
    }
}